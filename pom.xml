<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.github.gentity</groupId>
	<artifactId>gentity</artifactId>
	<version>1.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>gentity</name>
	<description>JPA Entity class generator from DBSchema (*.dbs) or MySQL Workbench (*.mwb) database models (see https://www.dbschema.com)</description>
	<modules>
		<module>gentity-test</module>
		<module>gentity-maven-plugin</module>
		<module>gentity-core</module>
		<module>gentity-lib</module>
	 <module>gentity-test-eclipselink</module>
	 <module>gentity-test-hibernate</module>
	</modules>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<netbeans.hint.licensePath>${basedir}/license-template-netbeans.ftl</netbeans.hint.licensePath>
		<netbeans.hint.license>apache20</netbeans.hint.license>
        <netbeans.hint.jdkPlatform>@@DEFAULT@@</netbeans.hint.jdkPlatform>
		<netbeans.compile.on.save>none</netbeans.compile.on.save>
	</properties>
	<organization>
		<name>The Gentity Project</name>
		<url>https://github.com/gentity/gentity</url>
	</organization>
	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>
	<prerequisites>
		<maven>3.5.0</maven>
	</prerequisites>
	<!-- No <distributionManagement> here on purpose: central-publishing-maven-plugin
	is declared with <extensions>true</extensions> below and takes over the deploy
	phase. Releases are uploaded to the Central Publisher Portal, snapshots to the
	Portal's snapshot repository (https://central.sonatype.com/repository/maven-snapshots/).
	Both use the 'central' server credentials from settings.xml. -->
	<scm>
		<connection>scm:git:https://github.com/gentity/gentity.git</connection>
		<developerConnection>scm:git:https://github.com/gentity/gentity.git</developerConnection>
		<url>https://github.com/gentity/gentity</url>
	  <tag>HEAD</tag>
  </scm>
	<url>https://github.com/gentity/gentity</url>
	<developers>
		<developer>
			<name>Uwe Pachler</name>
			<email>gentity.dev@gmail.com</email>
			<organization>The Gentity Project</organization>
			<organizationUrl>https://github.com/gentity/gentity</organizationUrl>
		</developer>
	</developers>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>jakarta.persistence</groupId>
				<artifactId>jakarta.persistence-api</artifactId>
				<version>3.1.0</version>
			</dependency>
            <dependency>
                <groupId>org.hsqldb</groupId>
                <artifactId>hsqldb</artifactId>
                <version>2.7.2</version>
            </dependency>
		</dependencies>
	</dependencyManagement>
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<version>3.12.0</version>
					<configuration>
						<doclint>none</doclint>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<tagNameFormat>v@{project.version}</tagNameFormat>
					<autoVersionSubmodules>true</autoVersionSubmodules>
					<releaseProfiles>release</releaseProfiles>
				</configuration>
			</plugin>
			<!-- Takes over the deploy phase: instead of deploying to a
			<distributionManagement> repository, it collects the reactor's
			artifacts into a single bundle and uploads it to the Central
			Publisher Portal. autoPublish=false means the deployment is
			validated but stays in the portal until someone presses
			'Publish' at https://central.sonatype.com/publishing/deployments -->
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.11.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<autoPublish>false</autoPublish>
					<!-- bundling runs in the context of the reactor's last module,
					so don't use ${project.artifactId} here -->
					<deploymentName>gentity ${project.version}</deploymentName>
				</configuration>
			</plugin>
		</plugins>
	</build>
	
	<profiles>
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.4.0</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<!-- version and doclint settings come from pluginManagement -->
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.8</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles> 
</project>
